# ---------------------------------------------------------------------------
# SmartFuel — environment configuration (example)
# ---------------------------------------------------------------------------

# Database. `DB_PROVIDER` = "sqlite" (local/dev) or "postgresql" (production).
DB_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
# Production example:
# DB_PROVIDER=postgresql
# DATABASE_URL="postgresql://smartfuel:CHANGE_ME@db.internal:5432/smartfuel?schema=public&connection_limit=20"

# Auth secret (>= 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="https://fuel.example.com"

# Session lifetime in seconds
SESSION_MAX_AGE_SECONDS=43200

# Shared secret that device webhooks must present (X-Device-Key header)
DEVICE_INGEST_KEY="replace-with-a-long-random-string"

# Real-time layer
REALTIME_TRANSPORT=sse

# Synthetic probe traffic for demos (off in production)
DEMO_SIMULATOR=off

# Rate limiting
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_SECONDS=60
