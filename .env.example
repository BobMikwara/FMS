# ---------------------------------------------------------------------------
# SmartFuel — environment configuration (example)
# ---------------------------------------------------------------------------

# Database. `DB_PROVIDER` = "sqlite" (local/dev) or "postgresql" (production).
DB_PROVIDER=sqlite
DATABASE_URL="file:./db/smartfuel.db"
# Production runtime example (Supabase shared transaction pooler, port 6543):
# DB_PROVIDER=postgresql
# DATABASE_URL="postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Use the Supabase direct connection (port 5432) for migrations, not a Vercel request.

# Auth secret (>= 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"
# Separate, persistent secret for AES-GCM encryption of authenticator credentials.
# Generate with: openssl rand -base64 32. Keep the same value across deployments.
MFA_ENCRYPTION_KEY="replace-with-a-separate-32-byte-random-secret"
AUTH_URL="https://fuel.example.com"

# Password reset email delivery (required outside local/demo environments)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-user"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="SmartFuel <no-reply@example.com>"

# Session lifetime in seconds
SESSION_MAX_AGE_SECONDS=43200

# Synthetic probe traffic for demos (off in production)
DEMO_SIMULATOR=off

# Vercel Cron maintenance endpoint (generate a random secret and set the same value in Vercel)
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Rate limiting
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_SECONDS=60
