{
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "src/app/api/stream/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/maintenance/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 0 * * *"
    }
  ]
}
